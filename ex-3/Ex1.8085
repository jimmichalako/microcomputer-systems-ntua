	IN 10H
	
	MVI A,10H  		 ;Set up Display
	STA 0B00H 
	STA 0B01H 
	STA 0B02H 
	STA 0B03H 
	STA 0B04H 
	STA 0B05H	
	
	MVI A,0DH		;Initialization of Interupt mask
	SIM
	EI
WAIT:
	JMP WAIT
INTR_ROUTINE:
	POP H			;POP return address so that the stack doesn't fill up
	EI			;Enable interrupts inside interrupt routine
	MVI H,05H 		;Counter for 5 iterations
	MOV A,H
	DCR A
	STA 0B05H		;Store tens in the 1st segment display 
FORTIES:
	MVI A,04H
	JMP UNIT_COUNTER
SECONDS:
	MVI A,09H		;Set up 9 secs (units)
UNIT_COUNTER:
	STA 0B04H		;Store units in the 2nd segment display
	CALL DISPLAY		
	DCR A 			
	CPI 00H 		;Compare with zero
	JNZ UNIT_COUNTER	;If Z=0 then we decrease the tens
	CALL ZERO		;Display zero unit (1 sec)
	DCR H			;Decrease counter
	JZ WAIT		;If Z=0 end timer
	MOV A,H
	DCR A		
	STA 0B05H
	JMP SECONDS		;Reset seconds until timer ends
DISPLAY: 	
	LXI B,0064H 		;100 msec delay
	LXI D,0B00H		;For STDM
	PUSH PSW
	PUSH H
	PUSH D
	PUSH B
	CALL STDM
	MVI A,00H 		;Turn on LEDs
	STA 3000H
	MVI A,0AH 		;10*100msec=1sec
1SEC:
	CALL DCD			
	CALL DELB
	DCR A
	CPI 05H
	JZ LIGHTS_OFF
	CPI 00H
	JNZ 1SEC
	POP B
	POP D
	POP H
	POP PSW
	RET
ZERO: 				;Display zero in the 2nd segment display
	MVI A,00H
	STA 0B04H
	CALL DISPLAY
	CALL DELB
	RET
LIGHTS_OFF:
	MVI A,FFH 		;Turn off LEDs
	STA 3000H
	MVI A,05H
	JMP 1SEC
	END
	